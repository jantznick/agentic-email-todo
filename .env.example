# --- IMAP (ingest) ---
IMAP_HOST=imap.fastmail.com
IMAP_PORT=993
IMAP_USER=todo@yourdomain.com
IMAP_PASS=app-password-here
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Processed
IMAP_QUARANTINE_FOLDER=Quarantine
# poll interval seconds when IDLE is unavailable
IMAP_POLL_INTERVAL=60

# --- Allowlist (ingest only; comma-separated, case-insensitive) ---
ALLOWLIST_EMAILS=you@example.com,spouse@example.com

# --- SMTP (worker ack replies) ---
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USER=todo@yourdomain.com
SMTP_PASS=app-password-here
SMTP_FROM=todo@yourdomain.com
# use SSL (465) or STARTTLS (587)
SMTP_USE_TLS=true

# --- Redis (override in Compose; set for local runs) ---
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_KEY=email_todo:jobs
REDIS_PROCESSED_KEY=email_todo:processed_message_ids

# --- OpenAI / LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# for LLM_PROVIDER=openai_compatible (local later):
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- Vikunja ---
VIKUNJA_BASE_URL=https://vikunja.example.com/api/v1
VIKUNJA_TOKEN=your-vikunja-api-token
VIKUNJA_FALLBACK_PROJECT=Email Inbox
VIKUNJA_NEEDS_GROOMING_LABEL=needs-grooming
# public UI base for deep links in ack emails (no /api)
VIKUNJA_UI_BASE_URL=https://vikunja.example.com

# --- Config mount ---
PROJECTS_CONFIG=/app/config/projects.yaml

# --- Logging ---
LOG_LEVEL=INFO
